import re
import json
import sys

# ==========================================
# STEP 1: Load file
# ==========================================
def load_lod(file_path):
    with open(file_path, "rb") as f:
        return f.read().decode(errors="ignore")


# ==========================================
# STEP 2: Parse Lavastorm array-tuple format
# ==========================================
def preprocess_to_json(content):
    """
    Convert raw LOD content into JSON.
    """
    try:
        return json.loads(content)
    except json.JSONDecodeError as e:
        print(f"[WARN] Direct JSON parse failed: {e}")
        return None


# ==========================================
# STEP 3: Resolve Lavastorm typed tuples
# ==========================================
def resolve(obj):
    """Convert ["Class", {...}] → {"__type__": "Class", ...}"""

    if isinstance(obj, list):
        if (
            len(obj) >= 2
            and isinstance(obj[0], str)
            and obj[0].startswith("com.lavastorm")
        ):
            class_name = obj[0].split(".")[-1]
            payload = obj[1] if len(obj) > 1 else {}

            resolved = {"__type__": class_name}

            if isinstance(payload, dict):
                for k, v in payload.items():
                    resolved[k] = resolve(v)
            else:
                resolved["__value__"] = resolve(payload)

            return resolved
        else:
            return [resolve(item) for item in obj]

    elif isinstance(obj, dict):
        return {k: resolve(v) for k, v in obj.items()}

    return obj


# ==========================================
# STEP 4: Extract nodes
# ==========================================
def find_nodes(obj, nodes=None):
    if nodes is None:
        nodes = []

    if isinstance(obj, dict):
        t = obj.get("__type__", "")

        if "id" in obj and ("type" in obj or "LeafNode" in t or "GraphDpo" in t):
            node_type = obj.get("type") or t
            node_id = obj.get("id")

            params = extract_param_values(obj.get("parameterValueMap", {}))

            in_clock = safe_get(obj, "inClock", "connectableId")
            in_event = safe_get(obj, "inEvent", "connectableId")
            out_event = safe_get(obj, "outEvent", "connectableId")

            input_ids = [v for v in [in_clock, in_event] if v]
            output_ids = [v for v in [out_event] if v]

            obj_str = json.dumps(obj)
            input_ids += list(set(re.findall(r'__in_[^"\\]+', obj_str)))
            output_ids += list(set(re.findall(r'__out_[^"\\]+', obj_str)))

            nodes.append({
                "id": node_id,
                "type": node_type,
                "parent": obj.get("parent"),
                "deleted": obj.get("deleted", False),
                "definitionalContainer": obj.get("definitionalContainer"),
                "inputs": list(set(input_ids)),
                "outputs": list(set(output_ids)),
                "parameters": params,
            })

        for v in obj.values():
            find_nodes(v, nodes)

    elif isinstance(obj, list):
        for item in obj:
            find_nodes(item, nodes)

    return nodes


def safe_get(obj, *keys):
    cur = obj
    for k in keys:
        if isinstance(cur, dict):
            cur = cur.get(k)
        else:
            return None
    return cur


# ==========================================
# STEP 5: Extract parameters
# ==========================================
def extract_param_values(param_map):
    if not isinstance(param_map, dict):
        return {}

    result = {}

    for key, val in param_map.items():
        if isinstance(val, dict):
            name = val.get("parameterName") or key
            result[name] = {
                "value": val.get("value"),
                "source": val.get("source"),
                "dataType": val.get("dataType"),
            }
        else:
            result[key] = {"value": val}

    return result


# ==========================================
# STEP 6: Extract edges
# ==========================================
def find_edges(obj, edges=None):
    if edges is None:
        edges = []

    if isinstance(obj, dict):
        node_id = obj.get("id")
        out_connectables = obj.get("outputDataConnectables")

        if node_id and isinstance(out_connectables, list):
            for conn in out_connectables:
                if isinstance(conn, dict):
                    target = conn.get("connectableId")
                    if target:
                        edges.append({"source": node_id, "target": target})

        for v in obj.values():
            find_edges(v, edges)

    elif isinstance(obj, list):
        for item in obj:
            find_edges(item, edges)

    return edges


# ==========================================
# STEP 7: Metadata
# ==========================================
def extract_graph_metadata(resolved):
    meta = {}
    obj_str = json.dumps(resolved)

    gid = re.search(r'"graphElementId"\s*:\s*"([^"]+)"', obj_str)
    meta["graphElementId"] = gid.group(1) if gid else None

    gid2 = re.search(r'"id"\s*:\s*"([0-9a-f\-]{36})"', obj_str)
    meta["graphId"] = gid2.group(1) if gid2 else None

    major = re.search(r'"major"\s*:\s*(\d+)', obj_str)
    minor = re.search(r'"minor"\s*:\s*(\d+)', obj_str)
    name = re.search(r'"name"\s*:\s*"([^"]+)"', obj_str)

    meta["modelVersion"] = {
        "major": int(major.group(1)) if major else None,
        "minor": int(minor.group(1)) if minor else None,
        "name": name.group(1) if name else None,
    }

    return meta


# ==========================================
# STEP 8: Execution sequence
# ==========================================
def build_execution_sequence(nodes, edges):
    sequence = []
    seen = set()

    targets = {e["target"] for e in edges}
    start_nodes = [n for n in nodes if n["id"] not in targets]

    queue = list(start_nodes)

    id_to_node = {n["id"]: n for n in nodes if n["id"]}
    outgoing = {}

    for e in edges:
        outgoing.setdefault(e["source"], []).append(e["target"])

    step = 1

    for node in queue:
        nid = node["id"]
        if nid in seen:
            continue

        seen.add(nid)

        sequence.append({
            "step": step,
            "node_id": nid,
            "type": node["type"],
            "parameters": node["parameters"],
        })

        step += 1

        for target_id in outgoing.get(nid, []):
            if target_id not in seen and target_id in id_to_node:
                queue.append(id_to_node[target_id])

    for node in nodes:
        if node["id"] not in seen:
            sequence.append({
                "step": step,
                "node_id": node["id"],
                "type": node["type"],
                "parameters": node["parameters"],
            })
            step += 1

    return sequence


# ==========================================
# STEP 9: MAIN
# ==========================================
def parse_lod(file_path):
    print(f"Loading: {file_path}")

    content = load_lod(file_path)

    print("Parsing...")
    raw = preprocess_to_json(content)

    if raw is None:
        print("Failed to parse JSON")
        sys.exit(1)

    resolved = resolve(raw)

    metadata = extract_graph_metadata(resolved)

    nodes = find_nodes(resolved)

    # Deduplicate
    seen_ids = set()
    nodes = [n for n in nodes if n["id"] and not (n["id"] in seen_ids or seen_ids.add(n["id"]))]

    edges = find_edges(resolved)

    sequence = build_execution_sequence(nodes, edges)

    return {
        "metadata": metadata,
        "nodes": nodes,
        "edges": edges,
        "execution_sequence": sequence,
    }


# ==========================================
# STEP 10: Save
# ==========================================
def save_output(workflow, output_file="parsed_workflow.json"):
    with open(output_file, "w", encoding="utf-8") as f:
        json.dump(workflow, f, indent=4)

    print(f"Saved: {output_file}")


# ==========================================
# RUN
# ==========================================
if __name__ == "__main__":
    file_path = sys.argv[1] if len(sys.argv) > 1 else "graph.lod"
    output_path = sys.argv[2] if len(sys.argv) > 2 else "parsed_workflow.json"

    workflow = parse_lod(file_path)
    save_output(workflow, output_path)
