# STEP 10: Save output

# ==========================================

def save_output(workflow, output_file=“parsed_workflow.json”):
with open(output_file, “w”, encoding=“utf-8”) as f:
json.dump(workflow, f, indent=4, ensure_ascii=False)

```
print(f"\n✅ Output saved to: {output_file}")
print(f"📊 Nodes     : {len(workflow['nodes'])}")
print(f"🔗 Edges     : {len(workflow['edges'])}")
print(f"📋 Seq Steps : {len(workflow['execution_sequence'])}")
print(f"🆔 Graph ID  : {workflow['metadata'].get('graphId')}")
```

