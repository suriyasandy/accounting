"""
Lavastorm D3S .lod → Workflow JSON Parser
"""

import json
import sys
import re
from collections import defaultdict, deque


# STEP 1: Load file
def load_lod(file_path: str) -> str:
    with open(file_path, "rb") as f:
        return f.read().decode(errors="ignore")


# STEP 2: Parse JSON
def parse_raw(content: str):
    try:
        return json.loads(content)
    except json.JSONDecodeError as e:
        print(f"[ERROR] JSON parse failed: {e}")
        sys.exit(1)


# STEP 3: Resolve Lavastorm tuples
def resolve(obj):
    if isinstance(obj, list):
        if (
            len(obj) == 2
            and isinstance(obj[0], str)
            and "." in obj[0]
            and isinstance(obj[1], (dict, list))
        ):
            class_name = obj[0].split(".")[-1]
            inner = resolve(obj[1])

            if isinstance(inner, dict):
                return {"__type__": class_name, **inner}
            else:
                return {"__type__": class_name, "__value__": inner}
        else:
            return [resolve(i) for i in obj]

    elif isinstance(obj, dict):
        return {k: resolve(v) for k, v in obj.items()}

    return obj


# STEP 4: Collect all objects by type
def collect_all(obj, bucket: dict):
    if isinstance(obj, dict):
        t = obj.get("__type__", "")
        if t:
            bucket.setdefault(t, []).append(obj)
        for v in obj.values():
            collect_all(v, bucket)

    elif isinstance(obj, list):
        for item in obj:
            collect_all(item, bucket)


# STEP 5: Extract parameters
def extract_params(param_value_map):
    if not isinstance(param_value_map, dict):
        return {}

    result = {}

    for key, val in param_value_map.items():
        if key == "__type__":
            continue

        if isinstance(val, dict):
            p_name = val.get("parameterName") or key
            result[p_name] = {
                "value": val.get("value"),
                "source": val.get("source"),
                "dataType": val.get("dataType"),
            }
        else:
            result[key] = {"value": val}

    return result


# STEP 6: Extract nodes
def extract_nodes(bucket: dict) -> list:
    nodes = []
    seen_ids = set()

    node_type_keys = [
        k for k in bucket
        if "LeafNode" in k or "CompositeNode" in k or "GraphDpo" in k
    ]

    for key in node_type_keys:
        for obj in bucket[key]:
            node_id = obj.get("id")

            if not node_id or node_id in seen_ids:
                continue

            seen_ids.add(node_id)

            internal_name = obj.get("internalName") or obj.get("handle") or ""
            node_type = obj.get("type") or obj.get("parentType") or key.split(".")[-1]
            parent = obj.get("parent") or obj.get("containerElementId")

            # Ports
            in_clock = (obj.get("inClock") or {}).get("connectableId")
            in_event = (obj.get("inEvent") or {}).get("connectableId")
            out_clock = (obj.get("outClock") or {}).get("connectableId")
            out_event = (obj.get("outEvent") or {}).get("connectableId")

            in_data, out_data = [], []

            for v in (obj.get("inputDataConnectables") or {}).values():
                if isinstance(v, dict):
                    cid = v.get("connectableId") or v.get("id")
                    if cid:
                        in_data.append(cid)

            for v in (obj.get("outputDataConnectables") or {}).values():
                if isinstance(v, dict):
                    cid = v.get("connectableId") or v.get("id")
                    if cid:
                        out_data.append(cid)

            params = extract_params(obj.get("parameterValueMap") or {})

            nodes.append({
                "id": node_id,
                "internalName": internal_name,
                "type": node_type,
                "parent": parent,
                "deleted": obj.get("deleted", False),
                "ports": {
                    "in_clock": in_clock,
                    "in_event": in_event,
                    "out_clock": out_clock,
                    "out_event": out_event,
                    "in_data": list(set(in_data)),
                    "out_data": list(set(out_data)),
                },
                "parameters": params,
            })

    return nodes


# STEP 7: Extract edges
def extract_edges(bucket: dict) -> list:
    edges = []
    seen = set()

    for key in bucket:
        if "Connection" in key:
            for obj in bucket[key]:
                start = obj.get("startPoint")
                end = obj.get("endPoint")

                if not start or not end:
                    continue

                edge_key = f"{start}|{end}"
                if edge_key in seen:
                    continue

                seen.add(edge_key)

                anchor = obj.get("anchor") or {}

                edges.append({
                    "id": obj.get("containerElementId"),
                    "source": start,
                    "target": end,
                    "connectableId": anchor.get("connectableId"),
                    "startWiring": obj.get("startPointWiring"),
                    "endWiring": obj.get("endPointWiring"),
                })

    return edges


# STEP 8: Metadata
def extract_metadata(bucket: dict) -> dict:
    meta = {}

    for key in bucket:
        if "GraphDpo" in key:
            obj = bucket[key][0]
            meta["graphId"] = obj.get("id")
            meta["graphElementId"] = obj.get("graphElementId")

    for key in bucket:
        if "ModelVersion" in key:
            obj = bucket[key][0]
            meta["modelVersion"] = {
                "major": obj.get("major"),
                "minor": obj.get("minor"),
                "patch": obj.get("patch"),
                "name": obj.get("name"),
            }

    return meta


# STEP 9: Topological sort
def build_execution_sequence(nodes, edges):
    id_map = {n["id"]: n for n in nodes}
    in_degree = defaultdict(int)
    graph = defaultdict(list)

    for e in edges:
        s, t = e["source"], e["target"]
        if s in id_map and t in id_map:
            graph[s].append(t)
            in_degree[t] += 1

    queue = deque([n for n in id_map if in_degree[n] == 0])

    sequence = []
    step = 1

    while queue:
        nid = queue.popleft()
        node = id_map[nid]

        sequence.append({
            "step": step,
            "node_id": nid,
            "internalName": node["internalName"],
            "type": node["type"],
            "parameters": node["parameters"],
        })

        step += 1

        for nxt in graph[nid]:
            in_degree[nxt] -= 1
            if in_degree[nxt] == 0:
                queue.append(nxt)

    return sequence


# MAIN
def parse_lod(file_path):
    content = load_lod(file_path)
    raw = parse_raw(content)
    resolved = resolve(raw)

    bucket = {}
    collect_all(resolved, bucket)

    nodes = extract_nodes(bucket)
    edges = extract_edges(bucket)
    metadata = extract_metadata(bucket)
    sequence = build_execution_sequence(nodes, edges)

    return {
        "metadata": metadata,
        "nodes": nodes,
        "edges": edges,
        "execution_sequence": sequence,
    }


# SAVE
def save_output(workflow, output_file="parsed_workflow.json"):
    with open(output_file, "w", encoding="utf-8") as f:
        json.dump(workflow, f, indent=2)


# RUN
if __name__ == "__main__":
    file_path = sys.argv[1] if len(sys.argv) > 1 else "graph.lod"
    output_path = sys.argv[2] if len(sys.argv) > 2 else "parsed_workflow.json"

    workflow = parse_lod(file_path)
    save_output(workflow, output_path)
