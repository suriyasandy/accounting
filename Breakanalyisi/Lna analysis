import re
import json


# ==========================================
# STEP 1: Load file
# ==========================================
def load_lod(file_path):
    with open(file_path, "rb") as f:
        return f.read().decode(errors="ignore")


# ==========================================
# STEP 2: Clean escaped code
# ==========================================
def clean_code(code):
    if not code:
        return code

    code = code.replace("\\n", "\n")
    code = code.replace('\\"', '"')
    code = code.replace("\\t", "\t")
    code = code.replace("\\r", "")
    return code.strip()


# ==========================================
# 🔥 STEP 3: SAFE VALUE EXTRACTOR (NO TRUNCATION)
# ==========================================
def extract_value_safe(text, start_index):
    """
    Extract string value handling escaped quotes properly
    """
    i = start_index
    value = ""
    escape = False

    while i < len(text):
        char = text[i]

        if escape:
            value += char
            escape = False
        elif char == "\\":
            escape = True
        elif char == '"':
            return value, i  # end of string
        else:
            value += char

        i += 1

    return value, i


# ==========================================
# STEP 4: Extract parameterName + FULL value
# ==========================================
def extract_parameters(chunk):
    params = {}
    idx = 0

    while True:
        param_pos = chunk.find('"parameterName"', idx)
        if param_pos == -1:
            break

        # Extract parameter name
        name_match = re.search(r'"parameterName"\s*:\s*"([^"]+)"', chunk[param_pos:])
        if not name_match:
            break

        name = name_match.group(1)

        # Find corresponding value
        value_key_pos = chunk.find('"value"', param_pos)
        if value_key_pos == -1:
            break

        # Find first quote after value:
        value_start = chunk.find('"', value_key_pos + 7) + 1

        # 🔥 Extract safely (THIS FIXES YOUR ISSUE)
        value, end_pos = extract_value_safe(chunk, value_start)

        params[name] = clean_code(value)

        idx = value_start + len(value)

    return params


# ==========================================
# STEP 5: Extract nodes
# ==========================================
def extract_nodes(content):
    nodes = []

    chunks = re.split(r'"internalName"\s*:\s*"', content)

    for chunk in chunks[1:]:
        node = {}

        # Node type
        node["type"] = chunk.split('"')[0]

        # Node ID
        id_match = re.search(r'"id"\s*:\s*"([^"]+)"', chunk)
        node["id"] = id_match.group(1) if id_match else None

        # Inputs / Outputs
        node["inputs"] = list(set(re.findall(r'"id"\s*:\s*"(__in_[^"]+__)"', chunk)))
        node["outputs"] = list(set(re.findall(r'"id"\s*:\s*"(__out_[^"]+__)"', chunk)))

        # 🔥 FULL parameter extraction (fixed)
        node["operations"] = extract_parameters(chunk)

        nodes.append(node)

    return nodes


# ==========================================
# STEP 6: Extract edges (optional)
# ==========================================
def extract_edges(content):
    edges = []

    connect_ids = re.findall(r'"connectableId"\s*:\s*"([^"]+)"', content)

    for i in range(0, len(connect_ids) - 1, 2):
        edges.append({
            "source": connect_ids[i],
            "target": connect_ids[i + 1]
        })

    return edges


# ==========================================
# STEP 7: Execution sequence
# ==========================================
def build_execution_sequence(nodes):
    sequence = []

    for i, node in enumerate(nodes):
        sequence.append({
            "step": i + 1,
            "node_id": node["id"],
            "type": node["type"],
            "operations": node["operations"]
        })

    return sequence


# ==========================================
# STEP 8: MAIN
# ==========================================
def parse_lod(file_path):
    content = load_lod(file_path)

    nodes = extract_nodes(content)
    edges = extract_edges(content)
    sequence = build_execution_sequence(nodes)

    return {
        "nodes": nodes,
        "edges": edges,
        "execution_sequence": sequence
    }


# ==========================================
# STEP 9: Save output
# ==========================================
def save_output(workflow, output_file="parsed_workflow.json"):
    with open(output_file, "w") as f:
        json.dump(workflow, f, indent=4)

    print(f"\n✅ Output saved to {output_file}")
    print(f"📊 Nodes: {len(workflow['nodes'])}")
    print(f"🔗 Edges: {len(workflow['edges'])}")


# ==========================================
# RUN
# ==========================================
if __name__ == "__main__":
    file_path = "your_file.lod"  # 👈 update path

    workflow = parse_lod(file_path)

    save_output(workflow)
