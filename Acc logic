import pandas as pd
import numpy as np

# =========================================================
# STEP 0: LOAD DATA
# =========================================================
# df should already contain TradeGroupKey
# Example:
# df = pd.read_csv("your_file.csv")

# =========================================================
# STEP 1: STANDARDIZE COLUMNS
# =========================================================
df["date"] = pd.to_datetime(df["DATE"])
df["abs_gbp"] = df["GBP_AMOUNT"].abs()

# Fill nulls (important for grouping)
df["CashFlag"] = df["CashFlag"].fillna("UNKNOWN")
df["BreakType"] = df["BreakType"].fillna("UNKNOWN")
df["AccountGroup"] = df["AccountGroup"].fillna("UNKNOWN")
df["Product"] = df["Product"].fillna("UNKNOWN")

# =========================================================
# STEP 2: AMOUNT BUCKETING
# =========================================================
def amount_bucket(x):
    if x < 1_000:
        return "0-1K"
    elif x < 10_000:
        return "1K-10K"
    elif x < 100_000:
        return "10K-100K"
    elif x < 1_000_000:
        return "100K-1M"
    else:
        return "1M+"

df["amt_bucket"] = df["abs_gbp"].apply(amount_bucket)

# =========================================================
# STEP 3: CREATE BREAK SIGNATURE
# =========================================================
df["BreakSignature"] = (
    df["CashFlag"].astype(str) + "|" +
    df["BreakType"].astype(str) + "|" +
    df["AccountGroup"].astype(str) + "|" +
    df["Product"].astype(str) + "|" +
    df["amt_bucket"].astype(str)
)

# =========================================================
# STEP 4: SORT DATA
# =========================================================
df = df.sort_values(["TradeGroupKey", "BreakSignature", "date"])

# =========================================================
# STEP 5: BREAK LINKING WITH DATE TOLERANCE (±2 DAYS)
# =========================================================
linked_rows = []
global_group_id = 0

for (tgk, sig), group in df.groupby(["TradeGroupKey", "BreakSignature"]):

    group = group.sort_values("date").copy()
    
    current_cluster = []
    base_date = None

    for idx, row in group.iterrows():

        if base_date is None:
            base_date = row["date"]
            current_cluster = [row]

        else:
            date_diff = abs((row["date"] - base_date).days)

            if date_diff <= 2:
                current_cluster.append(row)
            else:
                # Assign cluster ID
                global_group_id += 1
                for r in current_cluster:
                    r = r.copy()
                    r["LinkedBreakID"] = global_group_id
                    linked_rows.append(r)

                # Reset cluster
                base_date = row["date"]
                current_cluster = [row]

    # Final cluster
    if current_cluster:
        global_group_id += 1
        for r in current_cluster:
            r = r.copy()
            r["LinkedBreakID"] = global_group_id
            linked_rows.append(r)

# =========================================================
# STEP 6: FINAL LINKED DATAFRAME
# =========================================================
linked_df = pd.DataFrame(linked_rows)

# =========================================================
# STEP 7: OPTIONAL — AGGREGATED VIEW (VERY USEFUL)
# =========================================================
summary = (
    linked_df.groupby("LinkedBreakID")
    .agg(
        TradeGroupKey=("TradeGroupKey", "first"),
        BreakSignature=("BreakSignature", "first"),
        Total_Amount=("GBP_AMOUNT", "sum"),
        Count=("GBP_AMOUNT", "count"),
        Min_Date=("date", "min"),
        Max_Date=("date", "max")
    )
    .reset_index()
)

# =========================================================
# OUTPUT
# =========================================================
print("Linked Data Sample:")
print(linked_df.head())

print("\nSummary:")
print(summary.head())

