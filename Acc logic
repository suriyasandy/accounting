def _wrap(text: str, width: int) -> str:
“”“Wrap long rec names at word boundaries.”””
words = text.split()
lines, line = [], “”
for w in words:
if len(line) + len(w) + 1 > width and line:
lines.append(line)
line = w
else:
line = f”{line} {w}”.strip()
if line:
lines.append(line)
return “\n”.join(lines)

