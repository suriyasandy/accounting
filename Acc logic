    edge_col = EDGE_COLORS.get(account_group, EDGE_COLORS["unknown"])
    edge_title = (
        f"Product: {product}\n"
        f"Break Type: {break_type}\n"
        f"Account Group: {account_group}"
    )
    net.add_edge(
        frm, to,
        color=edge_col,
        width=3,
        title=edge_title,
        label=f"{product} | {account_group}",
    )

out_path = os.path.join(OUTPUT_DIR, output_html)
net.write_html(out_path)
print(f"[OK] Linkage diagram saved → {out_path}")
