# =========================================================
# CASHFOARE PHASE 1 — FINAL CORRECT VERSION
# Lifecycle + Monthly Rec Flow + Root Cause + Recurrence
# =========================================================

import pandas as pd
import numpy as np

# =========================================================
# STEP 0 — LOAD DATA
# =========================================================
# cash_df = pd.read_csv("cashfoare_daily.csv")
# mi_df   = pd.read_csv("monthly_mi.csv")


# =========================================================
# STEP 1 — STANDARDIZE
# =========================================================

def standardize_cash(df):
    df = df.copy()
    df["Date"] = pd.to_datetime(df["BREAK_DATE"], errors="coerce")
    df["TRADE_ID"] = df["TRADE_ID"].astype(str).str.strip()
    df["PRODUCT"] = df["PRODUCT"].astype(str).str.strip()
    df["BREAK"] = pd.to_numeric(df["BREAK"], errors="coerce").fillna(0)
    return df


def standardize_mi(df):
    df = df.copy()
    df["Date"] = pd.to_datetime(df["Date"], errors="coerce")
    df["TRADE REF"] = df["TRADE REF"].astype(str).str.strip()
    df["Rec"] = df["Rec Name (as per Rec Cube)"].astype(str).str.strip()
    return df


cash_df = standardize_cash(cash_df)
mi_df   = standardize_mi(mi_df)


# =========================================================
# STEP 2 — FILTER (Dec–Feb)
# =========================================================

START_DATE = "2025-12-01"
END_DATE   = "2026-02-28"

cash_df = cash_df[
    (cash_df["Date"] >= START_DATE) &
    (cash_df["Date"] <= END_DATE)
]

mi_df = mi_df[
    (mi_df["Date"] >= START_DATE) &
    (mi_df["Date"] <= END_DATE)
]

if "Age Days" in mi_df.columns:
    mi_df = mi_df[mi_df["Age Days"] <= 90]


# =========================================================
# STEP 3 — CASHFOARE CHAINS (WHEN)
# =========================================================

cash_df["TradeKey"] = cash_df["PRODUCT"] + "|" + cash_df["TRADE_ID"]

cash_df = cash_df.sort_values(["TradeKey", "Date"])
cash_df["BreakChainID"] = cash_df.groupby("TradeKey").ngroup()

chain_summary = (
    cash_df.groupby("BreakChainID")
    .agg(
        Trade=("TRADE_ID", "first"),
        Product=("PRODUCT", "first"),
        Start_Date=("Date", "min"),
        End_Date=("Date", "max"),
        Days_Active=("Date", "nunique"),
        Total_Breaks=("BREAK", "count"),
        Total_Amount=("BREAK", "sum")
    )
    .reset_index()
)

chain_summary["Is_Recurring"] = chain_summary["Days_Active"] > 1


# =========================================================
# STEP 4 — REC PRECEDENCE
# =========================================================

REC_ORDER = {
    "FOBO Rec-Equities": 1,
    "FOBO Rec-Dividend": 1,

    "Fidessa vs Fiscal vs FTP - Cash Equity": 2,
    "Fidessa vs FTP - Stock/Index Futures": 2,

    "FLARE vs Fiscal Cash Control (Cash Equities)": 3,
    "FLARE vs HUB Cash Contra (EQD Contra/control)": 4,
    "FLARE vs HUB Cash Contra (L&D)": 4,
    "Flare vs SYN - Cash Equities/SBL Control": 5,
    "Netted Cash Control - Cash equities/SBL": 6,

    "CRI COMPTA Rec - Cash Equities/SBL": 7,
    "CRI COMPTA Rec - SED": 7,
    "CRI COMPTA Rec - SEF": 7,

    "Sophis vs FTP - Cash Equity (P&L - MTM & Cash)": 8,
    "Sophis vs FTP - EQD (P&L - MTM & Cash)": 8,
    "Sophis vs FTP - ETD PnL": 8,

    "P&L Rec - CEQ": 9,
    "P&L Rec - SED": 9,
    "P&L Rec - SEF": 9,

    "Washbook '0006 Fiscal account' - Market Charges": 10,
}

mi_df["rec_rank"] = mi_df["Rec"].map(REC_ORDER).fillna(999)


# =========================================================
# STEP 5 — MONTH COLUMN (CRITICAL)
# =========================================================

mi_df["Month"] = mi_df["Date"].dt.to_period("M")

mi_df = mi_df.sort_values(["TRADE REF", "Month", "rec_rank", "Date"])


# =========================================================
# STEP 6 — REC FLOW PER MONTH
# =========================================================

def ordered_unique(x):
    return list(dict.fromkeys(x))


rec_flow_month = (
    mi_df.groupby(["TRADE REF", "Month"])
    .agg(
        Rec_List=("Rec", ordered_unique),
        Rec_Flow=("Rec", lambda x: " → ".join(ordered_unique(x)))
    )
    .reset_index()
)


# =========================================================
# STEP 7 — ROOT REC PER MONTH
# =========================================================

root_month = (
    mi_df.groupby(["TRADE REF", "Month"])
    .first()
    .reset_index()[["TRADE REF", "Month", "Rec"]]
    .rename(columns={"Rec": "Root_Rec"})
)


# =========================================================
# STEP 8 — JOURNAL FLAG PER MONTH
# =========================================================

mi_df["Journal_Flag"] = mi_df["Journals Posted"].notna()

journal_month = (
    mi_df.groupby(["TRADE REF", "Month"])
    .agg(Journal_Used=("Journal_Flag", "max"))
    .reset_index()
)


# =========================================================
# STEP 9 — MERGE MONTHLY VIEW
# =========================================================

monthly_view = rec_flow_month.merge(root_month, on=["TRADE REF", "Month"], how="left")
monthly_view = monthly_view.merge(journal_month, on=["TRADE REF", "Month"], how="left")


# =========================================================
# STEP 10 — RECURRING ROOT DETECTION
# =========================================================

repeat_summary = (
    monthly_view.groupby(["TRADE REF", "Root_Rec"])
    .agg(
        Months_Repeated=("Month", "nunique"),
        Journal_Count=("Journal_Used", "sum")
    )
    .reset_index()
)

repeat_summary["Is_Repeating_Root"] = repeat_summary["Months_Repeated"] >= 2


# =========================================================
# STEP 11 — FINAL MERGE WITH CASHFOARE
# =========================================================

final_summary = chain_summary.merge(
    repeat_summary,
    left_on="Trade",
    right_on="TRADE REF",
    how="left"
)


# =========================================================
# STEP 12 — FALSE CLOSURE (FINAL LOGIC)
# =========================================================

final_summary["False_Closure"] = (
    (final_summary["Is_Repeating_Root"] == True) &
    (final_summary["Journal_Count"] > 0)
)


# =========================================================
# STEP 13 — ROOT SYSTEM
# =========================================================

final_summary["Root_System"] = final_summary["Root_Rec"].str.split(" vs ").str[0]


# =========================================================
# STEP 14 — KPIs
# =========================================================

total = len(final_summary)
recurring = final_summary["Is_Recurring"].sum()
repeating_root = final_summary["Is_Repeating_Root"].sum()
false_closure = final_summary["False_Closure"].sum()

print("\n================ KPI SUMMARY ================")
print(f"Total Chains           : {total}")
print(f"Recurring Breaks       : {recurring} ({recurring/total:.1%})")
print(f"Repeating Root Causes  : {repeating_root} ({repeating_root/total:.1%})")
print(f"False Closures         : {false_closure} ({false_closure/total:.1%})")


# =========================================================
# STEP 15 — TOP ROOT SYSTEMS
# =========================================================

root_system_summary = (
    final_summary.groupby("Root_System")
    .agg(
        Total_Chains=("BreakChainID", "count"),
        False_Closures=("False_Closure", "sum")
    )
    .reset_index()
    .sort_values("Total_Chains", ascending=False)
)

print("\n===== TOP ROOT SYSTEMS =====")
print(root_system_summary.head(10))


# =========================================================
# STEP 16 — SAMPLE OUTPUT
# =========================================================

print("\n===== SAMPLE OUTPUT =====")
print(final_summary[[
    "Trade",
    "Product",
    "Days_Active",
    "Root_Rec",
    "Months_Repeated",
    "Journal_Count",
    "False_Closure"
]].head(10))


