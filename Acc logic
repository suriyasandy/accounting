    all_recs = [r for r in RECS.keys() if (layer_filter == "ALL" or RECS[r]["layer"] == layer_filter) and (prod_filter == "ALL" or RECS[r]["product"] == prod_filter)]

    left_col, right_col = st.columns([2, 3])
    with left_col:
        for layer in ["D3S", "FO", "MO", "BO"]:
            layer_recs = [r for r in all_recs if RECS[r]["layer"] == layer]
            if not layer_recs: continue
            st.markdown(f"<div style='color:{LAYER_COLOR[layer]['border']};font-size:9px;font-weight:800;'>{layer}</div>", unsafe_allow_html=True)
            selected_label = st.radio(f"_l_{layer}", ["(none)"] + [f"{rid} - {RECS[rid]['label']}" for rid in layer_recs], label_visibility="collapsed")
            if selected_label != "(none)": st.session_state["selected_rec"] = selected_label.split(" - ")[0]

    with right_col:
        sel = st.session_state.get("selected_rec")
        if sel in RECS:
            r = RECS[sel]
            st.markdown(f"### {r['label']}")
            st.write(r['desc'])
            up_edges = [e for e in EDGES if e[1] == sel]
            down_edges = [e for e in EDGES if e[0] == sel]
            if up_edges:
                st.markdown("**Upstream Causes**")
                for f, t, p, m in up_edges: st.caption(f"↑ {f} [{p}]: {m}")
            if down_edges:
                st.markdown("**Downstream Impacts**")
                for f, t, p, m in down_edges: st.caption(f"↓ {t} [{p}]: {m}")

elif page == "🧪 PoC Proof":
    if "poc_step" not in st.session_state: st.session_state["poc_step"] = 0
    step_idx = st.session_state["poc_step"]
    s = POC_STEPS[step_idx]
    st.subheader(s["title"])
    st.write(s["desc"])
    ev_col, ml_col = st.columns(2)
    ev_col.markdown(info_box("DATA", s["evidence"].replace("\n", "<br>"), s["color"]), unsafe_allow_html=True)
    ml_col.markdown(info_box("ML ACTION", s["ml_action"].replace("\n", "<br>"), "#a78bfa"), unsafe_allow_html=True)

    c1, c2 = st.columns(2)
    if c1.button("Back") and step_idx > 0:
        st.session_state["poc_step"] -= 1
        st.rerun()
    if c2.button("Next") and step_idx < len(POC_STEPS) - 1:
        st.session_state["poc_step"] += 1
        st.rerun()

elif page == "📈 Sankey Flow":
    st.plotly_chart(build_sankey(), use_container_width=True)

elif page == "📋 Impact Matrix":
    df = build_impact_matrix()
    st.dataframe(df, use_container_width=True)
