# ─── Sankey diagram ────────────────────────────────────────────────────────────

def build_sankey(filter_d3s: Optional[str] = None) -> go.Figure:
    edges = EDGES
    if filter_d3s:
        hop1_targets = {e[1] for e in edges if e[0] == filter_d3s}
        edges = [e for e in edges if e[0] == filter_d3s or e[0] in hop1_targets]

    nodes_set = []
    for frm, to, prob, _ in edges:
        if frm not in nodes_set: nodes_set.append(frm)
        if to not in nodes_set: nodes_set.append(to)
    node_idx = {n: i for i, n in enumerate(nodes_set)}

    node_labels = [RECS[n]["label"][:35] + ("..." if len(RECS[n]["label"]) > 35 else "") for n in nodes_set]
    node_colors = [LAYER_COLOR[RECS[n]["layer"]]["border"] for n in nodes_set]

    src, tgt, val, link_colors = [], [], [], []
    for frm, to, prob, _ in edges:
        src.append(node_idx[frm])
        tgt.append(node_idx[to])
        val.append(3 if prob == "H" else 2 if prob == "M" else 1)
        c = PROB_COLOR[prob]
        link_colors.append(c + "88")

    fig = go.Figure(go.Sankey(
        arrangement="snap",
        node=dict(
            pad=18, thickness=20,
            line=dict(color="#1e2d4a", width=0.5),
            label=node_labels,
            color=node_colors,
            hovertemplate="<b>%{label}</b><extra></extra>",
        ),
        link=dict(
            source=src, target=tgt, value=val, color=link_colors,
            hovertemplate="Flow probability: %{value}<extra></extra>",
        ),
    ))
    fig.update_layout(
        paper_bgcolor="#080d1a", plot_bgcolor="#080d1a",
        font=dict(family="monospace", size=10, color="#94a3b8"),
        height=520, margin=dict(l=10, r=10, t=30, b=10),
    )
    return fig

# ─── Impact matrix ────────────────────────────────────────────────────────────

def build_impact_matrix() -> pd.DataFrame:
    D3S_IDS = ["D3S_CEQ", "D3S_LND", "D3S_MTN", "D3S_OTC"]
    downstream = [rid for rid, r in RECS.items() if not r["poc"]]

    direct = {d: set(e[1] for e in EDGES if e[0] == d) for d in D3S_IDS}
    indirect = {}
    for d in D3S_IDS:
        ind = set()
        for mid in direct[d]:
            for e in EDGES:
                if e[0] == mid:
                    ind.add(e[1])
        indirect[d] = ind - direct[d]

    rows = []
    for rid in downstream:
        r = RECS[rid]
        row = {"Rec ID": rid, "Reconciliation": r["label"], "Layer": r["layer"], "Product": r["product"]}
        any_impact = False
        for d in D3S_IDS:
            if rid in direct[d]:
                prob = next(e[2] for e in EDGES if e[0] == d and e[1] == rid)
                row[d] = f"{PROB_LABEL[prob]} (direct)"
                any_impact = True
            elif rid in indirect[d]:
                row[d] = "MED (indirect)"
                any_impact = True
            else:
                row[d] = ""
        if any_impact: rows.append(row)

    return pd.DataFrame(rows)

