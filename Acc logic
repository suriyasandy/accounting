import streamlit as st
import pandas as pd

st.set_page_config(layout="wide")
st.title("📊 Break Intelligence Dashboard")

df = pd.read_csv("final_output.csv")

# Filters
st.sidebar.header("Filters")

product = st.sidebar.multiselect("Product", df["PRODUCT"].dropna().unique(), default=df["PRODUCT"].dropna().unique())
closure = st.sidebar.multiselect("Closure", df["Closure_Type"].unique(), default=df["Closure_Type"].unique())

df = df[df["Closure_Type"].isin(closure)]

# KPIs
col1, col2, col3 = st.columns(3)

col1.metric("Total", len(df))
col2.metric("False Closures", (df["Closure_Type"]=="FALSE_CLOSURE").sum())
col3.metric("True Closures", (df["Closure_Type"]=="TRUE_CLOSURE").sum())

# Trend
st.subheader("Monthly Trend")
trend = df.groupby(["Month","Closure_Type"]).size().unstack().fillna(0)
st.line_chart(trend)

# Root Analysis
st.subheader("Root Cause")
root = df.groupby("Root_Rec").size().sort_values(ascending=False)
st.bar_chart(root)

# Table
st.subheader("Details")
st.dataframe(df)

