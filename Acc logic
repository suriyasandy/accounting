# SECTION 5 — JOURNAL POSTING ANALYSIS

# ══════════════════════════════════════════════════════════════════════════════

def journal_posting_analysis(df: pd.DataFrame) -> dict[str, pd.DataFrame]:
“””
For every rec break in the MI report, compute:
- Total breaks
- Total journals posted (irrespective of root cause)
- Estimated unnecessary journals (inherited breaks)
- Potential saving if root cause identified
“””
rec_col  = COL[“rec_name”]
amt_col  = COL[“break_amount”]
bt_col   = COL[“break_type”]
ag_col   = COL[“account_group”]
team_col = COL[“team”]

```
# ── Per-rec journal summary ──────────────────────────────────────────────
jnl_col = "Journal Count" if "Journal Count" in df.columns else None

agg_dict: dict = {
    "Total Breaks":           (rec_col,  "count"),
    "Total Amount GBP":       (amt_col,  "sum"),
    "Unique Entities":        (COL["entity"], "nunique"),
    "Unique Products":        (COL["product"], "nunique"),
}
if jnl_col:
    agg_dict["Total Journals Posted"] = (jnl_col, "sum")
    agg_dict["Avg Journals Per Break"] = (jnl_col, "mean")

rec_summary = (
    df.groupby(rec_col)
    .agg(**agg_dict)
    .reset_index()
    .rename(columns={rec_col: "Rec Name"})
)

# Enrich with metadata
rec_summary["Precedence"]  = rec_summary["Rec Name"].map(
    lambda r: REC_META.get(r, {}).get("precedence", 99)
)
rec_summary["TLM Divide"]  = rec_summary["Rec Name"].map(
    lambda r: REC_META.get(r, {}).get("divide", "UNKNOWN")
)
rec_summary["TLM Stage"]   = rec_summary["Rec Name"].map(
    lambda r: REC_META.get(r, {}).get("tlm_stage", "UNKNOWN")
)
rec_summary["Frequency"]   = rec_summary["Rec Name"].map(
    lambda r: REC_META.get(r, {}).get("frequency", "UNKNOWN")
)

# Downstream recs — how many edges leave this rec in the propagation graph?
downstream_count = defaultdict(int)
for frm, to, *_ in PROPAGATION_EDGES:
    downstream_count[frm] += 1
rec_summary["Downstream Rec Count"] = rec_summary["Rec Name"].map(
    lambda r: downstream_count.get(r, 0)
)

# Is this a known root cause rec? (has outgoing edges)
rec_summary["Is Known Root Cause Rec"] = (
    rec_summary["Downstream Rec Count"] > 0
)

# Estimate inherited (false positive) breaks:
# Recs at precedence > 2 that have at least one upstream feeder are
# likely to have some inherited breaks (~40% based on your 3-month analysis)
# Adjust INHERITED_RATE to your validated figure.
INHERITED_RATE = 0.40

# Upstream feeder check
has_upstream = set(to for _, to, *_ in PROPAGATION_EDGES)
rec_summary["Has Upstream Feeder"] = rec_summary["Rec Name"].isin(has_upstream)

rec_summary["Est Inherited Breaks"] = (
    rec_summary.apply(
        lambda row: int(row["Total Breaks"] * INHERITED_RATE)
        if row["Has Upstream Feeder"] else 0,
        axis=1,
    )
)

if jnl_col:
    avg_jnl = (
        rec_summary["Total Journals Posted"] /
        rec_summary["Total Breaks"].clip(lower=1)
    )
    rec_summary["Est Suppressible Journals"] = (
        (rec_summary["Est Inherited Breaks"] * avg_jnl).round(0).astype(int)
    )
    rec_summary["Journal Saving %"] = (
        (rec_summary["Est Suppressible Journals"] /
         rec_summary["Total Journals Posted"].clip(lower=1) * 100)
        .round(1)
    )

rec_summary = rec_summary.sort_values(["Precedence", "Rec Name"])

# ── Break-type × account-group split ────────────────────────────────────
if bt_col in df.columns and ag_col in df.columns:
    bt_ag = (
        df.groupby([rec_col, bt_col, ag_col])
        .agg(
            Break_Count=(rec_col, "count"),
            Total_Amount=(amt_col, "sum"),
        )
        .reset_index()
        .rename(columns={rec_col: "Rec Name",
                          bt_col: "Break Type",
                          ag_col: "Account Group"})
    )
else:
    bt_ag = pd.DataFrame()

# ── Team ownership summary ───────────────────────────────────────────────
if team_col in df.columns:
    team_summary = (
        df.groupby([rec_col, team_col])
        .agg(
            Break_Count=(rec_col, "count"),
            Total_Amount=(amt_col, "sum"),
        )
        .reset_index()
        .rename(columns={rec_col: "Rec Name", team_col: "Team"})
    )
else:
    team_summary = pd.DataFrame()

return {
    "rec_summary": rec_summary,
    "break_type_ag": bt_ag,
    "team_summary": team_summary,
}
```

