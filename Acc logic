# =========================================================
# STEP 3 — STANDARDISE
# =========================================================
def standardise(df):
    df = df.copy()

    df["Date"] = pd.to_datetime(df["Date"], errors="coerce")

    str_cols = ["Entity", "Asset Class", "High Level Product", "TRADE REF", "Rec Name (as per Rec Cube)"]
    for col in str_cols:
        df[col] = df[col].astype(str).str.strip().fillna("UNKNOWN")

    df["BREAK AMOUNT GBP"] = pd.to_numeric(df["BREAK AMOUNT GBP"], errors="coerce").fillna(0)

    return df

df = standardise(df)

# =========================================================
# STEP 4 — REC RANK
# =========================================================
df["rec_rank"] = df["Rec Name (as per Rec Cube)"].map(REC_ORDER)
df["rec_rank"] = df["rec_rank"].fillna(999)

# =========================================================
# STEP 5 — TRADE KEY
# =========================================================
df["TradeKey"] = (
    df["Entity"] + "|" +
    df["Asset Class"] + "|" +
    df["High Level Product"] + "|" +
    df["TRADE REF"]
)

df["amt_bucket"] = (df["BREAK AMOUNT GBP"].abs() / 1000).round(0).astype(int).astype(str)

df["TradeKey_Fuzzy"] = (
    df["Entity"] + "|" +
    df["Asset Class"] + "|" +
    df["High Level Product"] + "|" +
    df["amt_bucket"]
)

# =========================================================
# STEP 6 — PARAMETERS
# =========================================================
MAX_DATE_GAP = 5

# =========================================================
# STEP 7 — CHAINING FUNCTION
# =========================================================
def chain_group(group, start_id):
    group = group.sort_values(["Date", "rec_rank"])
    results = []
    chain_id = start_id

    current_chain = []
    last_date = None

    for _, row in group.iterrows():

        if not current_chain:
            current_chain = [row]
            last_date = row["Date"]
            continue

        date_gap = (row["Date"] - last_date).days

        if date_gap <= MAX_DATE_GAP and row["rec_rank"] >= current_chain[-1]["rec_rank"]:
            current_chain.append(row)
            last_date = row["Date"]
        else:
            chain_id += 1
            for i, r in enumerate(current_chain):
                r = r.copy()
                r["BreakChainID"] = chain_id
                r["IsRootBreak"] = (i == 0)
                results.append(r)

            current_chain = [row]
            last_date = row["Date"]

    if current_chain:
        chain_id += 1
        for i, r in enumerate(current_chain):
            r = r.copy()
            r["BreakChainID"] = chain_id
            r["IsRootBreak"] = (i == 0)
            results.append(r)

    return results, chain_id

# =========================================================
# STEP 8 — APPLY CHAINING
# =========================================================
all_rows = []
chain_id = 0

for key, grp in df.groupby("TradeKey"):
    rows, chain_id = chain_group(grp, chain_id)
    all_rows.extend(rows)

chain_df = pd.DataFrame(all_rows)

# =========================================================
# STEP 9 — SUMMARY
# =========================================================
def ordered_unique(x):
    seen = []
    for i in x:
        if i not in seen:
            seen.append(i)
    return seen

summary = (
    chain_df.sort_values(["BreakChainID", "Date", "rec_rank"])
    .groupby("BreakChainID")
    .agg(
        Trade=("TRADE REF", "first"),
        Product=("High Level Product", "first"),
        Root_Rec=("Rec Name (as per Rec Cube)", "first"),
        Start_Date=("Date", "min"),
        End_Date=("Date", "max"),
        Rec_Count=("Rec Name (as per Rec Cube)", "nunique"),
        Rec_Flow=("Rec Name (as per Rec Cube)", lambda x: " → ".join(ordered_unique(x))),
        Total_Amount=("BREAK AMOUNT GBP", "sum"),
        Total_Breaks=("Date", "count"),
    )
    .reset_index()
)

# =========================================================
# STEP 10 — ROOT CAUSE
# =========================================================
root_cause = chain_df[chain_df["IsRootBreak"]].copy()

