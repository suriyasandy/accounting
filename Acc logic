import pandas as pd

# =========================================================
# STEP 1: STANDARDIZE DATA
# =========================================================
df["Date"] = pd.to_datetime(df["Date"])

# Create Trade Key (core identity)
df["TradeKey"] = (
    df["Entity"].astype(str) + "|" +
    df["Asset Class"].astype(str) + "|" +
    df["High Level Product"].astype(str) + "|" +
    df["TRADE REF"].astype(str)
)

# Sort properly
df = df.sort_values(["TradeKey", "Date"])

# =========================================================
# STEP 2: CHAIN BREAKS ACROSS RECS
# =========================================================
chain_rows = []
chain_id = 0

for trade_key, group in df.groupby("TradeKey"):

    group = group.sort_values("Date").copy()

    current_chain = []
    last_date = None

    for idx, row in group.iterrows():

        if last_date is None:
            current_chain = [row]
            last_date = row["Date"]

        else:
            date_diff = (row["Date"] - last_date).days

            # 🔥 CORE LOGIC
            # If break continues within 3 days → SAME CHAIN
            if date_diff <= 3:
                current_chain.append(row)
                last_date = row["Date"]
            else:
                # Close previous chain
                chain_id += 1
                for r in current_chain:
                    r = r.copy()
                    r["BreakChainID"] = chain_id
                    chain_rows.append(r)

                # Start new chain
                current_chain = [row]
                last_date = row["Date"]

    # Final chain
    if current_chain:
        chain_id += 1
        for r in current_chain:
            r = r.copy()
            r["BreakChainID"] = chain_id
            chain_rows.append(r)

# Final dataframe
chain_df = pd.DataFrame(chain_rows)

# =========================================================
# STEP 3: ANALYSIS VIEW (VERY IMPORTANT)
# =========================================================
summary = (
    chain_df.groupby("BreakChainID")
    .agg(
        TradeKey=("TradeKey", "first"),
        Trade_Ref=("TRADE REF", "first"),
        Entity=("Entity", "first"),
        Product=("High Level Product", "first"),
        Start_Date=("Date", "min"),
        End_Date=("Date", "max"),
        Rec_Count=("Rec Name (as per Rec Cube)", "nunique"),
        Rec_List=("Rec Name (as per Rec Cube)", lambda x: list(x.unique())),
        Total_Breaks=("Date", "count"),
        Total_Amount=("BREAK AMOUNT GBP", "sum")
    )
    .reset_index()
)

# =========================================================
# OUTPUT
# =========================================================
print(chain_df.head())
print(summary.head())

